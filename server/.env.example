# ========================================================
# Backend Environment Variables
# ========================================================

# Port for the server to listen on
PORT=5000

# Allowed frontend origin for CORS
# In local dev: http://localhost:5173
# In production: Your deployed Vercel URL (e.g., https://your-attendance-portal.vercel.app)
CLIENT_URL=http://localhost:5173

# Secret key used for signing JWT tokens (generate a strong random string before deploying)
JWT_SECRET=change-this-to-a-strong-random-secret-key

# Passcode required during faculty registration
FACULTY_SIGNUP_CODE=CSE-FACULTY-2026
